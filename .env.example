# Copy to .env at the repository root before running docker compose.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Application
APP_NAME=ESSVEE Payment Manager
COMPANY_NAME=ESSVEE Associates
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_PORT=8000

# Database (Docker Compose overrides the host with the db service)
POSTGRES_DB=essvee
POSTGRES_USER=essvee
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+psycopg://essvee:change-this-password@localhost:5432/essvee

# Bootstrap admin (used only when the users table is empty)
ADMIN_EMAIL=admin@essvee.in
ADMIN_PASSWORD=ChangeMe123!

# Payment provider: UPI opens the phone's UPI app chooser; RAZORPAY uses official Payment Links
PAYMENT_PROVIDER=UPI

# UPI deep link (required when PAYMENT_PROVIDER=UPI)
UPI_VPA=
UPI_PAYEE_NAME=
PUBLIC_BASE_URL=https://your-domain.com
UPI_AMOUNT_MODE=CUSTOMER_ENTERS

# Razorpay (optional; used only when PAYMENT_PROVIDER=RAZORPAY)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CALLBACK_URL=

# Meta WhatsApp Cloud API (leave empty until approved templates are available)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Automation
ENABLE_SCHEDULER=true
TIMEZONE=Asia/Kolkata
DB_ECHO=false
